<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://www.flowable.org/processdef" exporter="Camunda Modeler" exporterVersion="5.44.0">
  <process id="virementValidationProcess" name="Validation Virement &#62; 5000 EUR" isExecutable="true">
    <laneSet id="laneSet1">
      <lane id="laneAdmin" name="Administrateur">
        <flowNodeRef>taskValidationAdmin</flowNodeRef>
        <flowNodeRef>gwDecisionAdmin</flowNodeRef>
        <flowNodeRef>boundaryTimerAdmin</flowNodeRef>
        <flowNodeRef>gwMaxInfosAtteint</flowNodeRef>
      </lane>
      <lane id="laneSysteme" name="Système / IA">
        <flowNodeRef>taskVerifierCompte</flowNodeRef>
        <flowNodeRef>gwCompteValide</flowNodeRef>
        <flowNodeRef>taskNotifyCompteBloque</flowNodeRef>
        <flowNodeRef>endRejectedCompte</flowNodeRef>
        <flowNodeRef>taskVerifierSolde</flowNodeRef>
        <flowNodeRef>gwSolde</flowNodeRef>
        <flowNodeRef>taskNotifySoldeInsuffisant</flowNodeRef>
        <flowNodeRef>endRejectedSolde</flowNodeRef>
        <flowNodeRef>taskVerifierBeneficiaire</flowNodeRef>
        <flowNodeRef>gwBeneficiaire</flowNodeRef>
        <flowNodeRef>taskNotifyBeneficiaireInvalide</flowNodeRef>
        <flowNodeRef>endRejectedBenef</flowNodeRef>
        <flowNodeRef>taskExecuteVirement</flowNodeRef>
        <flowNodeRef>gwExecutionOk</flowNodeRef>
        <flowNodeRef>taskRetryVirement</flowNodeRef>
        <flowNodeRef>gwRetryOk</flowNodeRef>
        <flowNodeRef>endEscalade</flowNodeRef>
        <flowNodeRef>taskNotifyApprouve</flowNodeRef>
        <flowNodeRef>taskNotifyErreurTech</flowNodeRef>
        <flowNodeRef>endErreurTech</flowNodeRef>
        <flowNodeRef>taskAuditLog</flowNodeRef>
        <flowNodeRef>endApproved</flowNodeRef>
        <flowNodeRef>taskNotifyRejet</flowNodeRef>
        <flowNodeRef>endRejectedAdmin</flowNodeRef>
        <flowNodeRef>taskEscaladeTimeout</flowNodeRef>
      </lane>
      <lane id="laneClient" name="Client">
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>taskFournirInfos</flowNodeRef>
        <flowNodeRef>endClientTimeout</flowNodeRef>
        <flowNodeRef>boundaryTimerClient</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="startEvent" name="Virement&#10;déclenché&#10;(&#62; 5000 EUR)" />
    <sequenceFlow id="sf01" sourceRef="startEvent" targetRef="taskVerifierCompte" />
    <serviceTask id="taskVerifierCompte" name="Vérifier statut&#10;du compte" flowable:delegateExpression="${verifierCompteDelegate}" />
    <sequenceFlow id="sf02" sourceRef="taskVerifierCompte" targetRef="gwCompteValide" />
    <exclusiveGateway id="gwCompteValide" name="Compte&#10;actif ?" />
    <sequenceFlow id="sfCompteOk" name="Oui" sourceRef="gwCompteValide" targetRef="taskVerifierSolde">
      <conditionExpression xsi:type="tFormalExpression">${compteActif == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfCompteKo" name="Non" sourceRef="gwCompteValide" targetRef="taskNotifyCompteBloque">
      <conditionExpression xsi:type="tFormalExpression">${compteActif == false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="taskNotifyCompteBloque" name="Notifier client&#10;(compte bloqué)" flowable:delegateExpression="${notifyClientDelegate}">
      <extensionElements>
        <flowable:field name="notificationType">
          <flowable:string>ACCOUNT_BLOCKED</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sfCompteEnd" sourceRef="taskNotifyCompteBloque" targetRef="endRejectedCompte" />
    <endEvent id="endRejectedCompte" name="Rejeté&#10;(compte bloqué)" />
    <serviceTask id="taskVerifierSolde" name="Vérifier solde&#10;suffisant" flowable:delegateExpression="${verifierSoldeDelegate}" />
    <sequenceFlow id="sf03" sourceRef="taskVerifierSolde" targetRef="gwSolde" />
    <exclusiveGateway id="gwSolde" name="Solde&#10;suffisant ?" />
    <sequenceFlow id="sfSoldeOk" name="Oui" sourceRef="gwSolde" targetRef="taskVerifierBeneficiaire">
      <conditionExpression xsi:type="tFormalExpression">${soldeSuffisant == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfSoldeKo" name="Non" sourceRef="gwSolde" targetRef="taskNotifySoldeInsuffisant">
      <conditionExpression xsi:type="tFormalExpression">${soldeSuffisant == false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="taskNotifySoldeInsuffisant" name="Notifier client&#10;(solde insuffisant)" flowable:delegateExpression="${notifyClientDelegate}">
      <extensionElements>
        <flowable:field name="notificationType">
          <flowable:string>INSUFFICIENT_FUNDS</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sfSoldeEnd" sourceRef="taskNotifySoldeInsuffisant" targetRef="endRejectedSolde" />
    <endEvent id="endRejectedSolde" name="Rejeté&#10;(solde insuff.)" />
    <serviceTask id="taskVerifierBeneficiaire" name="Vérifier bénéficiaire&#10;(IBAN valide)" flowable:delegateExpression="${verifierBeneficiaireDelegate}" />
    <sequenceFlow id="sf04" sourceRef="taskVerifierBeneficiaire" targetRef="gwBeneficiaire" />
    <exclusiveGateway id="gwBeneficiaire" name="Bénéficiaire&#10;valide ?" />
    <sequenceFlow id="sfBenefOk" name="Oui" sourceRef="gwBeneficiaire" targetRef="taskValidationAdmin">
      <conditionExpression xsi:type="tFormalExpression">${beneficiaireValide == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfBenefKo" name="Non" sourceRef="gwBeneficiaire" targetRef="taskNotifyBeneficiaireInvalide">
      <conditionExpression xsi:type="tFormalExpression">${beneficiaireValide == false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="taskNotifyBeneficiaireInvalide" name="Notifier client&#10;(bénéficiaire invalide)" flowable:delegateExpression="${notifyClientDelegate}">
      <extensionElements>
        <flowable:field name="notificationType">
          <flowable:string>INVALID_BENEFICIARY</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sfBenefEnd" sourceRef="taskNotifyBeneficiaireInvalide" targetRef="endRejectedBenef" />
    <endEvent id="endRejectedBenef" name="Rejeté&#10;(bénéf. invalide)" />
    <userTask id="taskValidationAdmin" name="Valider le virement" flowable:candidateGroups="admin">
      <documentation>Client: ${clientName} | Montant: ${amount} EUR | Bénéficiaire: ${beneficiary} | Tentatives: ${infoRequestCount}</documentation>
    </userTask>
    <boundaryEvent id="boundaryTimerAdmin" name="48h sans réponse" attachedToRef="taskValidationAdmin">
      <timerEventDefinition>
        <timeDuration>PT48H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="sfTimerAdmin" sourceRef="boundaryTimerAdmin" targetRef="taskEscaladeTimeout" />
    <sequenceFlow id="sf05" sourceRef="taskValidationAdmin" targetRef="gwDecisionAdmin" />
    <exclusiveGateway id="gwDecisionAdmin" name="Décision&#10;Admin" />
    <sequenceFlow id="sfApprove" name="Approuver" sourceRef="gwDecisionAdmin" targetRef="taskExecuteVirement">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'APPROVE'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfReject" name="Rejeter" sourceRef="gwDecisionAdmin" targetRef="taskNotifyRejet">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'REJECT'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfRequestInfo" name="Demander infos" sourceRef="gwDecisionAdmin" targetRef="gwMaxInfosAtteint">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'REQUEST_INFO'}</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="gwMaxInfosAtteint" name="Nb demandes&#10;&#60; 3 ?" />
    <sequenceFlow id="sfInfoOk" name="Oui (&#60;3)" sourceRef="gwMaxInfosAtteint" targetRef="taskFournirInfos">
      <conditionExpression xsi:type="tFormalExpression">${infoRequestCount &lt; 3}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfInfoMax" name="Non (≥3)" sourceRef="gwMaxInfosAtteint" targetRef="taskEscaladeTimeout">
      <conditionExpression xsi:type="tFormalExpression">${infoRequestCount &gt;= 3}</conditionExpression>
    </sequenceFlow>
    <userTask id="taskFournirInfos" name="Fournir informations&#10;complémentaires" flowable:assignee="${userId}" />
    <boundaryEvent id="boundaryTimerClient" name="24h sans réponse" attachedToRef="taskFournirInfos">
      <timerEventDefinition>
        <timeDuration>PT24H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="sfClientTimeout" sourceRef="boundaryTimerClient" targetRef="endClientTimeout" />
    <endEvent id="endClientTimeout" name="Timeout client&#10;(24h)" />
    <sequenceFlow id="sf06" sourceRef="taskFournirInfos" targetRef="taskValidationAdmin" />
    <serviceTask id="taskExecuteVirement" name="Exécuter le virement" flowable:delegateExpression="${executeVirementDelegate}" />
    <sequenceFlow id="sf07" sourceRef="taskExecuteVirement" targetRef="gwExecutionOk" />
    <exclusiveGateway id="gwExecutionOk" name="Exécution&#10;réussie ?" />
    <sequenceFlow id="sfExecOk" name="Oui" sourceRef="gwExecutionOk" targetRef="taskNotifyApprouve">
      <conditionExpression xsi:type="tFormalExpression">${virementExecute == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfExecKo" name="Non" sourceRef="gwExecutionOk" targetRef="taskRetryVirement">
      <conditionExpression xsi:type="tFormalExpression">${virementExecute == false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="taskRetryVirement" name="Retry exécution&#10;(1 tentative)" flowable:delegateExpression="${executeVirementDelegate}" />
    <sequenceFlow id="sf08" sourceRef="taskRetryVirement" targetRef="gwRetryOk" />
    <exclusiveGateway id="gwRetryOk" name="Retry&#10;réussi ?" />
    <sequenceFlow id="sfRetryOk" name="Oui" sourceRef="gwRetryOk" targetRef="taskNotifyApprouve">
      <conditionExpression xsi:type="tFormalExpression">${virementExecute == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfRetryKo" name="Non" sourceRef="gwRetryOk" targetRef="taskNotifyErreurTech">
      <conditionExpression xsi:type="tFormalExpression">${virementExecute == false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="taskEscaladeTimeout" name="Escalader vers&#10;superviseur" flowable:delegateExpression="${escaladeDelegate}" />
    <sequenceFlow id="sfEscalade" sourceRef="taskEscaladeTimeout" targetRef="endEscalade" />
    <endEvent id="endEscalade" name="Escaladé&#10;superviseur" />
    <serviceTask id="taskAuditLog" name="Enregistrer&#10;audit log" flowable:delegateExpression="${auditLogDelegate}" />
    <serviceTask id="taskNotifyApprouve" name="Notifier client&#10;(approuvé)" flowable:delegateExpression="${notifyClientDelegate}">
      <extensionElements>
        <flowable:field name="notificationType">
          <flowable:string>APPROVED</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sfApprouveAudit" sourceRef="taskNotifyApprouve" targetRef="taskAuditLog" />
    <sequenceFlow id="sfApprouveEnd" sourceRef="taskAuditLog" targetRef="endApproved" />
    <endEvent id="endApproved" name="Virement&#10;exécuté ✓" />
    <serviceTask id="taskNotifyRejet" name="Notifier client&#10;(rejeté par admin)" flowable:delegateExpression="${notifyClientDelegate}">
      <extensionElements>
        <flowable:field name="notificationType">
          <flowable:string>REJECTED</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sfRejetEnd" sourceRef="taskNotifyRejet" targetRef="endRejectedAdmin" />
    <endEvent id="endRejectedAdmin" name="Rejeté&#10;par admin" />
    <serviceTask id="taskNotifyErreurTech" name="Notifier client&#10;(erreur technique)" flowable:delegateExpression="${notifyClientDelegate}">
      <extensionElements>
        <flowable:field name="notificationType">
          <flowable:string>TECHNICAL_ERROR</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sfErreurEnd" sourceRef="taskNotifyErreurTech" targetRef="endErreurTech" />
    <endEvent id="endErreurTech" name="Erreur&#10;technique ⚠" />
  </process>
