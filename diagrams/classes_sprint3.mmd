classDiagram
    class User {
      +UUID id
      +String email
      +UserRole role
    }
    class Account {
      +UUID id
      +String agency
      +String number
      +BigDecimal balance
      +AccountStatus status
      +credit(amount)
      +debit(amount)
    }
    class Transaction {
      +UUID id
      +BigDecimal amount
      +TransactionType type
      +TransactionStatus status
      +String description
      +LocalDateTime createdAt
    }
    class Card {
      +UUID id
      +CardType cardType
      +CardBrand brand
      +String lastFour
      +BigDecimal creditLimit
      +Boolean active
    }
    class Investment {
      +UUID id
      +InvestmentType investmentType
      +BigDecimal amount
      +BigDecimal currentValue
      +InvestmentStatus status
    }
    class PaymentKey {
      +UUID id
      +PaymentKeyType keyType
      +String keyValue
    }

    User "1" --> "1..*" Account : possède
    User "1" --> "0..*" Transaction : effectue
    User "1" --> "0..*" Card : possède
    User "1" --> "0..*" Investment : détient
    User "1" --> "0..*" PaymentKey : enregistre
    Account "1" --> "0..*" Transaction : source
    Account "0..1" --> "0..*" Transaction : cible
