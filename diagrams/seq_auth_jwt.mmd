%% FinBank - authentification JWT avec double authentification
sequenceDiagram
    actor U as Utilisateur
    participant I as Interface
    participant AC as AuthController
    participant AS as AuthService
    participant AM as AuthenticationManager
    participant UR as UserRepository
    participant JW as JwtService
    participant RR as RefreshTokenRepository

    U->>I: Saisir email et mot de passe
    I->>AC: POST /auth/login
    AC->>AS: login(request)
    AS->>UR: Rechercher l'utilisateur par email
    UR-->>AS: User
    AS->>AM: Vérifier les identifiants

    alt Identifiants incorrects
        AM-->>AS: Échec d'authentification
        AS-->>AC: Erreur d'authentification
        AC-->>I: 401 Unauthorized
        I-->>U: Afficher un message d'erreur
    else Compte bloqué ou inactif
        AM-->>AS: Compte non autorisé
        AS-->>AC: Accès refusé
        AC-->>I: 403 Forbidden
        I-->>U: Afficher le statut du compte
    else 2FA activée
        AM-->>AS: Authentification réussie
        AS->>JW: Générer un tempToken (5 min)
        JW-->>AS: tempToken
        AS-->>AC: twoFactorRequired + tempToken
        AC-->>I: Demander le code 2FA
        I-->>U: Saisir le code TOTP
        U->>I: Envoyer le code 2FA
        I->>AC: POST /auth/verify-2fa
        AC->>AS: verify2fa(tempToken, code)
        AS->>JW: Extraire l'utilisateur du tempToken
        JW-->>AS: Email utilisateur
        AS->>UR: Rechercher l'utilisateur
        UR-->>AS: User
        AS->>AS: Vérifier le code TOTP
        alt Code 2FA incorrect
            AS-->>AC: Erreur de vérification
            AC-->>I: 401 Unauthorized
            I-->>U: Afficher un message d'erreur
        else Code 2FA correct
            AS->>JW: Générer le JWT d'accès
            JW-->>AS: accessToken
            AS->>RR: Enregistrer le refresh token
            RR-->>AS: RefreshToken enregistré
            AS-->>AC: accessToken + refreshToken
            AC-->>I: 200 OK
            I-->>U: Accéder au tableau de bord
        end
    else Compte actif sans 2FA
        AM-->>AS: Authentification réussie
        AS->>JW: Générer le JWT d'accès
        JW-->>AS: accessToken
        AS->>RR: Enregistrer le refresh token
        RR-->>AS: RefreshToken enregistré
        AS-->>AC: accessToken + refreshToken
        AC-->>I: 200 OK
        I-->>U: Accéder au tableau de bord
    end
