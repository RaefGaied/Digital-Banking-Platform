%% FinBank - cas d'utilisation du Sprint 2 (backend Spring Boot et sécurité)
%% Exporter ce diagramme en PNG sous Figures/usecase_sprint2.png
flowchart LR
    User(("Utilisateur (USER)"))
    Admin(("Administrateur"))

    subgraph FinBank["FinBank - Sprint 2 : backend Spring Boot et sécurité"]
        direction TB

        Register(("Créer un compte"))
        Login(("S'authentifier"))
        Profile(("Gérer son profil et sa sécurité"))
        Password(("Modifier le mot de passe"))
        Enable2FA(("Activer la double authentification"))
        Verify2FA(("Vérifier le code 2FA"))
        Users(("Gérer les utilisateurs"))
        Block(("Bloquer un utilisateur"))
        Unblock(("Débloquer un utilisateur"))
    end

    User --- Register
    User --- Login
    User --- Profile
    User --- Password
    User --- Enable2FA
    Admin --- Login
    Admin --- Users

    Profile -.->|"«include»"| Password
    Profile -.->|"«include»"| Enable2FA
    Verify2FA -.->|"«extend» [si 2FA activée]"| Login
    Users -.->|"«include»"| Block
    Users -.->|"«include»"| Unblock

    classDef actor fill:#fff2cc,stroke:#b8860b,stroke-width:2px,color:#000;
    classDef usecase fill:#dae8fc,stroke:#2f5597,stroke-width:1px,color:#000;
    class User,Admin actor;
    class Register,Login,Profile,Password,Enable2FA,Verify2FA,Users,Block,Unblock usecase;
