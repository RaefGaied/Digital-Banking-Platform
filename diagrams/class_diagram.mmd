    WorkflowTask ..> TaskType : taskType
    WorkflowTask ..> ActionType : actionType
    Session ..> SessionStatus : status
    Message ..> SenderType : senderType
    Notification ..> NotificationType : type
    Notification ..> NotificationChannel : channel
    SecurityEvent ..> SecurityEventType : type
    BankingAgent ..> AgentDecision : decision and defaultPolicy
    IntentResult ..> IntentType : intent

    note for Message "sessionId is a scalar UUID mapped to session_uuid. No database FK to Session."
    note for AuditLog "sessionId is a scalar UUID; migrations add an index, not a foreign key."
    note for BankingAgent "lastTransactionId is a scalar UUID without a transaction FK."
    note for Session "agentId is a scalar UUID. The FK is on BankingAgent.sessionId instead."
    note for RagDocument "The embedding vector is stored/updated through JDBC and is not a Java entity field."
    note for AdminTicketAction "API enum; not stored on a persistent entity."
    note for User "The V1 SQL migration defines cpf, but User.java has no cpf field; it is intentionally omitted here."
