%% FinBank - modele de domaine complet avec methodes publiques
%% Les methodes d'acces Lombok, constructeurs et callbacks JPA sont omis.
%% Les relations pleines correspondent aux associations JPA; les pointilles aux FK SQL sur des identifiants scalaires.
%% Les methodes listees sont celles qui s'appliquent directement sur l'entite.
classDiagram
    direction LR

    class User {
        UUID id
        String name
        String email
        String password
        UserRole role
        UserStatus status
        Boolean active
        Integer failedLoginAttempts
        LocalDateTime lockedUntil
        String deviceFingerprint
        Boolean twoFactorEnabled
        String twoFactorSecret
        LocalDateTime createdAt
        LocalDateTime updatedAt
        +getAuthorities() Collection
        +getUsername() String
        +isAccountNonExpired() boolean
        +isAccountNonLocked() boolean
        +isCredentialsNonExpired() boolean
        +isEnabled() boolean
    }

    class Account {
        UUID id
        User user
        String agency
        String number
        BigDecimal balance
        AccountStatus status
        LocalDateTime createdAt
        LocalDateTime updatedAt
        +credit(amount: BigDecimal) void
        +debit(amount: BigDecimal) void
    }

    class Transaction {
        UUID id
        Account sourceAccount
        Account targetAccount
        BigDecimal amount
        TransactionType type
        TransactionStatus status
        String description
        String flowableProcessId
        LocalDateTime createdAt
    }

    class Card {
        UUID id
        User user
        CardType cardType
        CardBrand brand
        String holderName
        String lastFour
        Integer expiryMonth
        Integer expiryYear
        BigDecimal creditLimit
        BigDecimal availableLimit
        Boolean active
        LocalDateTime createdAt
    }

    class Investment {
        UUID id
        User user
        InvestmentType investmentType
        BigDecimal amount
        BigDecimal annualRate
        BigDecimal currentValue
        InvestmentStatus status
        LocalDateTime investedAt
        LocalDateTime redeemedAt
    }

    class PaymentKey {
        UUID id
        User user
        PaymentKeyType keyType
        String keyValue
        Boolean active
        Boolean verified
        String verificationMethod
        LocalDateTime verifiedAt
        LocalDateTime createdAt
    }

    class SupportTicket {
        Long id
        UUID userId
        String subject
        String description
        TicketStatus status
        TicketPriority priority
        TicketType ticketType
        UUID assignedAdminId
        UUID ownerId
        String flowableProcessId
        String attachmentName
        String attachmentType
        byte[] attachmentData
        LocalDateTime createdAt
        LocalDateTime updatedAt
        LocalDateTime resolvedAt
        LocalDateTime closedAt
    }

    class WorkflowTask {
        Long id
        String processInstanceId
        Long supportTicketId
        WorkflowTaskStatus status
        TaskType taskType
        String description
        UUID assignedTo
        ActionType actionType
        LocalDateTime dueDate
        LocalDateTime breachedAt
        Integer escalationLevel
        Map metadata
        LocalDateTime createdAt
        LocalDateTime updatedAt
        LocalDateTime completedAt
    }

    class Session {
        UUID id
        UUID userId
        SessionStatus status
        String ipAddress
        UUID agentId
        LocalDateTime createdAt
        LocalDateTime lastActivityAt
        LocalDateTime closedAt
        +open() void
        +close() void
        +isActive() boolean
        +isExpired() boolean
    }

    class Message {
        Long id
        UUID sessionId
        UUID senderId
        SenderType senderType
        String content
        Boolean isInternal
        String intent
        JsonNode parameters
        String detectedLang
        Boolean ragUsed
        String ragSource
        LocalDateTime createdAt
        LocalDateTime updatedAt
    }

    class BankingAgent {
        UUID id
        UUID sessionId
        UUID userId
        JsonNode context
        UUID lastTransactionId
        AgentDecision decision
        AgentDecision defaultPolicy
        LocalDateTime createdAt
        LocalDateTime updatedAt
    }

    class Notification {
        UUID id
        UUID userId
        NotificationType type
        NotificationChannel channel
        String title
        String body
        Long referenceId
        String referenceType
        Boolean isRead
        LocalDateTime createdAt
        LocalDateTime readAt
        +markAsRead() void
    }

    class SecurityEvent {
        UUID id
        UUID userId
        SecurityEventType type
        String ipAddress
        String deviceId
        Boolean resolved
        LocalDateTime timestamp
        +resolve() void
    }

    class AuditLog {
        UUID id
        String userEmail
        String action
        String entity
        String entityId
        String details
        String ipAddress
        UUID sessionId
        String status
        LocalDateTime createdAt
    }

    class AuthToken {
        UUID id
        UUID userId
        String token
        LocalDateTime expiresAt
        Boolean revoked
        String deviceId
        String ipAddress
        LocalDateTime lastUsed
        LocalDateTime createdAt
        +isExpired() boolean
        +isValid() boolean
        +revoke() void
    }

    class RefreshToken {
        UUID id
        User user
        String token
        LocalDateTime expiresAt
        Boolean revoked
        LocalDateTime createdAt
        +isExpired() boolean
        +isValid() boolean
    }

    class PasswordResetToken {
        UUID id
        User user
        String tokenHash
        LocalDateTime expiresAt
        LocalDateTime usedAt
        +isValid() boolean
    }

    class RagDocument {
        Long id
        String title
        String content
        String source
        Boolean active
        LocalDateTime createdAt
        LocalDateTime updatedAt
    }

    class IntentResult {
        <<valueObject>>
        IntentType intent
        JsonNode parameters
        Double confidence
        String message
        Boolean isSensitive
        String detectedLanguage
        +isConfident() boolean
        +requiresInfo() boolean
    }

    class UserDetails {
        <<interface>>
    }

    User ..|> UserDetails : implements Spring Security

    User "1" --> "0..*" Account : JPA user
    User "1" --> "0..*" Card : JPA user
    User "1" --> "0..*" Investment : JPA user
    User "1" --> "0..*" PaymentKey : JPA user
    User "1" --> "0..*" RefreshToken : JPA user
    User "1" --> "0..*" PasswordResetToken : JPA user

    Account "0..1" <-- "0..*" Transaction : sourceAccount
    Account "0..1" <-- "0..*" Transaction : targetAccount

    User "1" .. "0..*" SupportTicket : SQL FK userId
    User "0..1" .. "0..*" SupportTicket : SQL FK assignedAdminId
    User "0..1" .. "0..*" WorkflowTask : SQL FK assignedTo
    SupportTicket "0..1" .. "0..*" WorkflowTask : SQL FK supportTicketId
    User "1" .. "0..*" Message : SQL FK senderId
    User "1" .. "0..*" Session : SQL FK userId
    User "1" .. "0..*" BankingAgent : SQL FK userId
    Session "1" .. "0..1" BankingAgent : SQL FK sessionId unique
    User "1" .. "0..*" Notification : SQL FK userId
    User "1" .. "0..*" SecurityEvent : SQL FK userId
    User "1" .. "0..*" AuthToken : SQL FK userId

