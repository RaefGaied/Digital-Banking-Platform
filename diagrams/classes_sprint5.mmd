classDiagram
    class User {
      +UUID id
      +UserRole role
    }
    class Transaction {
      +UUID id
      +TransactionStatus status
      +String flowableProcessId
    }
    class WorkflowTask {
      +UUID id
      +String processInstanceId
      +TaskType taskType
      +WorkflowTaskStatus status
      +String decision
    }
    class Notification {
      +UUID id
      +String type
      +Boolean read
    }
    class FlowableService {
      +listAdminTasks()
      +getProcessInstances()
      +getProcessInstanceDetails()
      +completeTask()
    }
    class FlowableTaskCompletionService {
      +completeTask(taskId, variables)
    }
    class AdminController {
      +getTasks()
      +getTask()
      +action()
    }

    User "1" --> "0..*" Transaction : initie
    User "1" --> "0..*" WorkflowTask : traite
    Transaction "1" --> "0..*" WorkflowTask : déclenche
    User "1" --> "0..*" Notification : reçoit
    AdminController --> FlowableService : consulte
    AdminController --> FlowableTaskCompletionService : complète
    FlowableTaskCompletionService --> WorkflowTask : met à jour
