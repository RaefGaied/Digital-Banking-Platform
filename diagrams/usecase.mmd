%% FinBank - diagramme global de cas d'utilisation
%% Disposition : systemes secondaires a gauche, FinBank au centre, acteurs humains a droite.
%% Perimetre fonctionnel : application FinBank, avec l'agent IA et Flowable comme systemes secondaires.
%% Le code actuel decrit ai-agent comme un fallback; l'autonomie complete est un objectif cible, pas une capacite acquise.
%% Authentification requise pour les cas proteges; representee comme precondition, sans include repetitif.
%% Les scenarios detailles seront raffines au chapitre 3.
%% Import Draw.io : Arrange > Insert > Advanced > Mermaid
flowchart LR
    Agent["Agent bancaire intelligent<br/>objectif d'autonomie"]
    Flowable["Moteur de workflow<br/>Flowable BPMN"]

    subgraph FinBank["FinBank - plateforme bancaire"]
        direction TB

        subgraph ClientCases["Services client"]
            Auth(("S'authentifier"))
            BankingInfo(("Consulter ses informations bancaires"))
            BankingOps(("Effectuer des operations bancaires"))
            Payment(("Gerer ses cartes et moyens de paiement"))
            Investments(("Gerer ses investissements"))
            Analytics(("Consulter son tableau de bord financier"))
            Assistant(("Utiliser l'assistant bancaire"))
            Profile(("Gerer son profil, ses sessions et sa securite"))
            Support(("Gerer ses demandes de support"))
            Notifications(("Consulter et gerer ses notifications"))
        end

        subgraph AgentCases["Services intelligents"]
            Interpret(("Interpreter la demande en langage naturel"))
            AuthorizedAction(("Executer une operation confirmee et autorisee"))
            KnowledgeSearch(("Rechercher une information dans la base RAG"))
            Escalate(("Soumettre une operation a validation"))
        end

        subgraph AdminCases["Administration et supervision"]
            Users(("Gerer les utilisateurs"))
            ReviewTasks(("Traiter les tickets et valider les taches sensibles"))
            Security(("Superviser la securite et les journaux d'audit"))
            KnowledgeAdmin(("Administrer les documents de connaissances"))
            Workflow(("Orchestrer la validation BPMN"))
        end
    end

    Client(("Client"))
    Admin(("Administrateur"))

    Agent --- Assistant
    Agent --- Interpret
    Agent --- AuthorizedAction
    Agent --- KnowledgeSearch
    Agent --- Escalate
    Agent --- Support
    Flowable --- Workflow
    Flowable --- ReviewTasks

    Auth --- Client
    BankingInfo --- Client
    BankingOps --- Client
    Payment --- Client
    Investments --- Client
    Analytics --- Client
    Assistant --- Client
    Profile --- Client
    Support --- Client
    Notifications --- Client

    Auth --- Admin
    Users --- Admin
    ReviewTasks --- Admin
    Security --- Admin
    KnowledgeAdmin --- Admin

    Assistant -.->|"«include»"| Interpret
    KnowledgeSearch -.->|"«extend» si une reponse documentaire est utile"| Assistant
    AuthorizedAction -.->|"«extend» si une action metier est demandee"| Assistant
    Escalate -.->|"«extend» si une validation est requise"| Assistant
    Escalate -.->|"«include»"| Workflow

    classDef actor fill:#fff2cc,stroke:#b8860b,stroke-width:2px,color:#000;
    classDef usecase fill:#dae8fc,stroke:#2f5597,stroke-width:1px,color:#000;
    classDef secondary fill:#fce4d6,stroke:#c55a11,stroke-width:1px,color:#000;

    class Agent,Flowable secondary;
    class Client,Admin actor;
    class Auth,BankingInfo,BankingOps,Payment,Investments,Analytics,Assistant,Profile,Support,Notifications,Interpret,AuthorizedAction,KnowledgeSearch,Escalate,Users,ReviewTasks,Security,KnowledgeAdmin,Workflow usecase;
