%% Diagramme global de cas d'utilisation - FinBank
%% Les raffinements par module seront presentes au chapitre 3.
%% Compatible avec Draw.io : Arrange > Insert > Advanced > Mermaid
flowchart LR
    Client(("Client"))
    Admin(("Administrateur / support"))

    subgraph FinBank["FinBank - plateforme bancaire"]
        direction TB

        subgraph ClientCases["Services principaux du client"]
            Auth(("Acceder a la plateforme"))
            Account(("Consulter ses informations bancaires"))
            Operations(("Effectuer des operations bancaires"))
            PaymentMethods(("Gerer ses moyens de paiement"))
            Investments(("Gerer ses investissements"))
            Analytics(("Consulter son tableau de bord financier"))
            Assistant(("Utiliser l'assistant bancaire"))
            Profile(("Gerer son profil"))
            Support(("Soumettre et suivre une demande de support"))
        end

        subgraph AdminCases["Services principaux d'administration"]
            Users(("Administrer les utilisateurs"))
            SupportTasks(("Traiter les demandes et taches sensibles"))
            Supervise(("Superviser l'activite et les evenements de securite"))
            Knowledge(("Gerer la base de connaissances"))
        end
    end

    Client --> Auth
    Client --> Account
    Client --> Operations
    Client --> PaymentMethods
    Client --> Investments
    Client --> Analytics
    Client --> Assistant
    Client --> Profile
    Client --> Support

    Admin --> Auth
    Admin --> Users
    Admin --> SupportTasks
    Admin --> Supervise
    Admin --> Knowledge

    classDef actor fill:#fff2cc,stroke:#b8860b,stroke-width:2px,color:#000;
    classDef usecase fill:#dae8fc,stroke:#2f5597,stroke-width:1px,color:#000;

    class Client,Admin actor;
    class Auth,Account,Operations,PaymentMethods,Investments,Analytics,Assistant,Profile,Support,Users,SupportTasks,Supervise,Knowledge usecase;
