%% Diagramme de cas d'utilisation global - FinBank
%% Compatible avec Draw.io : Arrange > Insert > Advanced > Mermaid
flowchart LR
    Client(("Client"))
    Admin(("Administrateur<br/>ou support"))
    Payment(("Passerelle de<br/>paiement"))
    AI(("Service IA"))
    Flowable(("Flowable<br/>BPMN"))
    Notify(("Service de<br/>notification"))

    subgraph FinBank["Systeme FinBank"]
        direction TB

        subgraph Security["Authentification et securite"]
            Register(("S'inscrire"))
            Login(("S'authentifier"))
            Profile(("Gerer le profil"))
        end

        subgraph Banking["Operations bancaires"]
            Dashboard(("Consulter le tableau<br/>de bord"))
            Account(("Consulter le compte<br/>et le solde"))
            History(("Consulter l'historique<br/>des transactions"))
            Transfer(("Effectuer un<br/>virement"))
            Pix(("Gerer les paiements<br/>PIX"))
            Cards(("Gerer les cartes<br/>bancaires"))
            Investments(("Gerer les<br/>investissements"))
            Analytics(("Consulter les<br/>analyses"))
        end

        subgraph Assistance["Assistance et supervision"]
            Chat(("Utiliser l'assistant<br/>bancaire"))
            Claim(("Soumettre et suivre<br/>une reclamation"))
            Notifications(("Consulter les<br/>notifications"))
            Users(("Gerer les<br/>utilisateurs"))
            Tasks(("Traiter les taches<br/>sensibles"))
            Audit(("Consulter les<br/>journaux d'audit"))
        end

        Detect(("Analyser l'intention"))
        Validate(("Valider une operation<br/>sensible"))
        Execute(("Executer le paiement"))
        NotifyClient(("Notifier le client"))
    end

    Client --> Register
    Client --> Login
    Client --> Dashboard
    Client --> Account
    Client --> History
    Client --> Transfer
    Client --> Pix
    Client --> Cards
    Client --> Investments
    Client --> Analytics
    Client --> Profile
    Client --> Chat
    Client --> Claim
    Client --> Notifications

    Admin --> Login
    Admin --> Users
    Admin --> Tasks
    Admin --> Audit
    Admin --> Claim

    Payment --> Execute
    AI --> Detect
    Flowable --> Validate
    Notify --> NotifyClient

    Register -.->|inclut| Login
    Dashboard -.->|inclut| Login
    Account -.->|inclut| Login
    History -.->|inclut| Login
    Transfer -.->|inclut| Login
    Pix -.->|inclut| Login
    Cards -.->|inclut| Login
    Investments -.->|inclut| Login
    Profile -.->|inclut| Login
    Chat -.->|inclut| Login
    Claim -.->|inclut| Login

    Chat -.->|analyse le message| Detect
    Transfer -.->|operation sensible| Validate
    Pix -.->|declenche| Execute
    Transfer -.->|declenche| Execute
    Validate -.->|operation autorisee| Execute
    Transfer -.->|confirme| NotifyClient
    Investments -.->|alerte de rendement| NotifyClient
    Claim -.->|mise a jour| NotifyClient
    Validate -.->|trace| Audit

    classDef actor fill:#fff2cc,stroke:#b8860b,stroke-width:2px,color:#000;
    classDef usecase fill:#dae8fc,stroke:#2f5597,stroke-width:1px,color:#000;
    classDef internal fill:#e2f0d9,stroke:#548235,stroke-width:1px,color:#000;
    class Client,Admin,Payment,AI,Flowable,Notify actor;
    class Register,Login,Profile,Dashboard,Account,History,Transfer,Pix,Cards,Investments,Analytics,Chat,Claim,Notifications,Users,Tasks,Audit usecase;
    class Detect,Validate,Execute,NotifyClient internal;
