%% FinBank - diagramme de classes du Sprint 2
%% Exporter ce diagramme en PNG sous Figures/classes_sprint2.png
classDiagram
    direction LR

    class User {
        +UUID id
        +String name
        +String email
        +String password
        +UserRole role
        +UserStatus status
        +Boolean active
        +Integer failedLoginAttempts
        +LocalDateTime lockedUntil
        +String deviceFingerprint
        +Boolean twoFactorEnabled
        +String twoFactorSecret
        +LocalDateTime createdAt
        +LocalDateTime updatedAt
    }

    class RefreshToken {
        +UUID id
        +User user
        +String token
        +LocalDateTime expiresAt
        +Boolean revoked
        +isExpired()
        +isValid()
    }

    class PasswordResetToken {
        +UUID id
        +User user
        +String tokenHash
        +LocalDateTime expiresAt
        +LocalDateTime usedAt
        +isValid()
    }

    class AuthToken {
        +UUID id
        +UUID userId
        +String token
        +LocalDateTime expiresAt
        +Boolean revoked
        +String deviceId
        +String ipAddress
        +LocalDateTime lastUsed
        +LocalDateTime createdAt
        +isExpired()
        +isValid()
        +revoke()
    }

    class UserRole {
        <<enumeration>>
        ROLE_USER
        ROLE_ADMIN
    }

    class UserStatus {
        <<enumeration>>
        INACTIVE
        ACTIVE
        BLOCKED
    }

    User "1" --> "0..*" RefreshToken : possède
    User "1" --> "0..*" PasswordResetToken : utilise
    User --> UserRole : possède
    User --> UserStatus : possède
    AuthToken ..> User : identifie par userId
