      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MaxNon_Edge" bpmnElement="Flow_MaxNon">
        <omgdi:waypoint x="1470" y="720" />
        <omgdi:waypoint x="1560" y="720" />
        <omgdi:waypoint x="1560" y="800" />
        <omgdi:waypoint x="1670" y="800" />
