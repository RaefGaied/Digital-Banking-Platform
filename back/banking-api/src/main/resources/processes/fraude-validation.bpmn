<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <process id="fraudValidationProcess" name="Gestion Fraude" isExecutable="true">
    <laneSet id="LaneSet_1">
      <lane id="Lane_Admin" name="Admin">
        <flowNodeRef>Task_AnalyseFraude</flowNodeRef>
        <flowNodeRef>Task_Escalade</flowNodeRef>
        <flowNodeRef>Gateway_MaxInfos</flowNodeRef>
        <flowNodeRef>Boundary_AdminTimeout</flowNodeRef>
        <flowNodeRef>Gateway_DecisionAdmin</flowNodeRef>
        <flowNodeRef>Event_EndEscalade</flowNodeRef>
      </lane>
      <lane id="Lane_Systeme" name="Système">
        <flowNodeRef>Task_VerifierCompte</flowNodeRef>
        <flowNodeRef>Task_NotifyCompteBloque</flowNodeRef>
        <flowNodeRef>Task_BloquerCarte</flowNodeRef>
        <flowNodeRef>Task_NotifyBlocage</flowNodeRef>
        <flowNodeRef>Task_NotifyContact</flowNodeRef>
        <flowNodeRef>Task_NotifyFauxPositif</flowNodeRef>
        <flowNodeRef>Task_AuditLog</flowNodeRef>
        <flowNodeRef>Task_NotifyErreur</flowNodeRef>
        <flowNodeRef>Gateway_CompteActif</flowNodeRef>
        <flowNodeRef>Event_EndCompteBloque</flowNodeRef>
        <flowNodeRef>Event_EndFraudeTraitee</flowNodeRef>
        <flowNodeRef>Gateway_BlocageOk</flowNodeRef>
        <flowNodeRef>Event_EndErreur</flowNodeRef>
      </lane>
      <lane id="Lane_Client" name="Client">
        <flowNodeRef>Task_FournirJustificatifs</flowNodeRef>
        <flowNodeRef>Event_Start</flowNodeRef>
        <flowNodeRef>Boundary_ClientTimeout</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Event_Start" name="Fraude signalée">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <serviceTask id="Task_VerifierCompte" name="Vérifier statut compte" camunda:delegateExpression="${verifCompteDelegate}">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_CompteActif" name="Compte actif?">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_CompteOui</outgoing>
      <outgoing>Flow_CompteNon</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Task_VerifierCompte" />
    <sequenceFlow id="Flow_2" sourceRef="Task_VerifierCompte" targetRef="Gateway_CompteActif" />
    <sequenceFlow id="Flow_CompteOui" name="Oui" sourceRef="Gateway_CompteActif" targetRef="Task_AnalyseFraude">
      <conditionExpression>${compteActif==true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CompteNon" name="Non" sourceRef="Gateway_CompteActif" targetRef="Task_NotifyCompteBloque">
      <conditionExpression>${compteActif==false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_NotifyCompteBloque" name="Notifier compte bloqué" camunda:delegateExpression="${notifyDelegate}">
      <incoming>Flow_CompteNon</incoming>
      <outgoing>Flow_CompteEnd</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_CompteEnd" sourceRef="Task_NotifyCompteBloque" targetRef="Event_EndCompteBloque" />
    <endEvent id="Event_EndCompteBloque" name="Compte bloqué">
      <incoming>Flow_CompteEnd</incoming>
    </endEvent>
    <userTask id="Task_AnalyseFraude" name="Analyser fraude" camunda:candidateGroups="admin">
      <incoming>Flow_CompteOui</incoming>
      <incoming>Flow_MaxOui</incoming>
      <outgoing>Flow_3</outgoing>
    </userTask>
    <boundaryEvent id="Boundary_AdminTimeout" name="48h écoulées" attachedToRef="Task_AnalyseFraude">
      <outgoing>Flow_AdminTimeout_out</outgoing>
      <timerEventDefinition>
        <timeDuration>PT48H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="Flow_AdminTimeout_out" sourceRef="Boundary_AdminTimeout" targetRef="Task_Escalade" />
    <sequenceFlow id="Flow_3" sourceRef="Task_AnalyseFraude" targetRef="Gateway_DecisionAdmin" />
    <exclusiveGateway id="Gateway_DecisionAdmin" name="Décision">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_Bloquer</outgoing>
      <outgoing>Flow_Contacter</outgoing>
      <outgoing>Flow_FauxPositif</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_Bloquer" name="Bloquer" sourceRef="Gateway_DecisionAdmin" targetRef="Task_BloquerCarte">
      <conditionExpression>${decision=='BLOQUER'}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_BloquerCarte" name="Bloquer carte" camunda:delegateExpression="${bloquerCarteDelegate}">
      <incoming>Flow_Bloquer</incoming>
      <outgoing>Flow_4</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_4" sourceRef="Task_BloquerCarte" targetRef="Gateway_BlocageOk" />
    <exclusiveGateway id="Gateway_BlocageOk" name="Blocage OK?">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_BlocageOui</outgoing>
      <outgoing>Flow_BlocageNon</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_BlocageOui" name="Oui" sourceRef="Gateway_BlocageOk" targetRef="Task_NotifyBlocage">
      <conditionExpression>${blocageOk==true}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_NotifyBlocage" name="Notifier blocage" camunda:delegateExpression="${notifyDelegate}">
      <incoming>Flow_BlocageOui</incoming>
      <outgoing>Flow_5</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_5" sourceRef="Task_NotifyBlocage" targetRef="Task_AuditLog" />
    <sequenceFlow id="Flow_BlocageNon" name="Non" sourceRef="Gateway_BlocageOk" targetRef="Task_NotifyErreur">
      <conditionExpression>${blocageOk==false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_NotifyErreur" name="Notifier erreur" camunda:delegateExpression="${notifyDelegate}">
      <incoming>Flow_BlocageNon</incoming>
      <outgoing>Flow_ErreurEnd</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_ErreurEnd" sourceRef="Task_NotifyErreur" targetRef="Event_EndErreur" />
    <endEvent id="Event_EndErreur" name="Erreur blocage">
      <incoming>Flow_ErreurEnd</incoming>
    </endEvent>
    <sequenceFlow id="Flow_Contacter" name="Contacter" sourceRef="Gateway_DecisionAdmin" targetRef="Task_NotifyContact">
      <conditionExpression>${decision=='CONTACTER'}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_NotifyContact" name="Demander justificatifs" camunda:delegateExpression="${notifyDelegate}">
      <incoming>Flow_Contacter</incoming>
      <outgoing>Flow_6</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_6" sourceRef="Task_NotifyContact" targetRef="Task_FournirJustificatifs" />
    <userTask id="Task_FournirJustificatifs" name="Fournir justificatifs" camunda:assignee="${userId}">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
    </userTask>
    <boundaryEvent id="Boundary_ClientTimeout" name="24h écoulées" attachedToRef="Task_FournirJustificatifs">
      <outgoing>Flow_ClientTimeout_out</outgoing>
      <timerEventDefinition>
        <timeDuration>PT24H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="Flow_ClientTimeout_out" sourceRef="Boundary_ClientTimeout" targetRef="Task_Escalade" />
    <sequenceFlow id="Flow_7" sourceRef="Task_FournirJustificatifs" targetRef="Gateway_MaxInfos" />
    <exclusiveGateway id="Gateway_MaxInfos" name="Nbinfos &#60; 3?">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_MaxOui</outgoing>
      <outgoing>Flow_MaxNon</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_MaxOui" name="Oui" sourceRef="Gateway_MaxInfos" targetRef="Task_AnalyseFraude">
      <conditionExpression>${nbInfos &lt; 3}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_MaxNon" name="Non" sourceRef="Gateway_MaxInfos" targetRef="Task_Escalade">
      <conditionExpression>${nbInfos &gt;= 3}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_FauxPositif" name="Faux positif" sourceRef="Gateway_DecisionAdmin" targetRef="Task_NotifyFauxPositif">
      <conditionExpression>${decision=='FAUX_POSITIF'}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_NotifyFauxPositif" name="Notifier faux positif" camunda:delegateExpression="${notifyDelegate}">
      <incoming>Flow_FauxPositif</incoming>
      <outgoing>Flow_8</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_8" sourceRef="Task_NotifyFauxPositif" targetRef="Task_AuditLog" />
    <serviceTask id="Task_AuditLog" name="Audit log" camunda:delegateExpression="${auditDelegate}">
      <incoming>Flow_5</incoming>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_AuditEnd</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_AuditEnd" sourceRef="Task_AuditLog" targetRef="Event_EndFraudeTraitee" />
    <endEvent id="Event_EndFraudeTraitee" name="Fraude traitée">
      <incoming>Flow_AuditEnd</incoming>
    </endEvent>
    <serviceTask id="Task_Escalade" name="Escalade superviseur" camunda:delegateExpression="${escaladeDelegate}">
      <incoming>Flow_MaxNon</incoming>
      <incoming>Flow_AdminTimeout_out</incoming>
      <incoming>Flow_ClientTimeout_out</incoming>
      <outgoing>Flow_EscaladeEnd</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_EscaladeEnd" sourceRef="Task_Escalade" targetRef="Event_EndEscalade" />
    <endEvent id="Event_EndEscalade" name="Escalade">
      <incoming>Flow_EscaladeEnd</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="fraudValidationProcess">
      <bpmndi:BPMNShape id="Lane_Admin_Shape" bpmnElement="Lane_Admin" isHorizontal="true">
        <omgdc:Bounds x="160" y="620" width="1900" height="420" />
