        <di:waypoint x="1270" y="145" />
        <di:waypoint x="1332" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfRejetEnd_e" bpmnElement="sfRejetEnd">
        <di:waypoint x="2260" y="290" />
        <di:waypoint x="2322" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfEscalade_e" bpmnElement="sfEscalade">
        <di:waypoint x="2460" y="410" />
