<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <process id="dataUpdateValidationProcess" name="Validation Modification Donnees Sensibles" isExecutable="true">
    <laneSet id="laneSet1">
      <lane id="laneClient" name="Client">
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>endClientTimeout</flowNodeRef>
        <flowNodeRef>taskFournirPreuve</flowNodeRef>
        <flowNodeRef>boundaryTimerClient</flowNodeRef>
      </lane>
      <lane id="laneSysteme" name="Systeme / notifications">
        <flowNodeRef>taskNotifyApprouve</flowNodeRef>
        <flowNodeRef>taskAuditLog</flowNodeRef>
        <flowNodeRef>endApproved</flowNodeRef>
        <flowNodeRef>taskNotifyRejet</flowNodeRef>
        <flowNodeRef>endRejectedAdmin</flowNodeRef>
        <flowNodeRef>taskEscaladeTimeout</flowNodeRef>
        <flowNodeRef>endEscalade</flowNodeRef>
      </lane>
      <lane id="laneAdmin" name="Administrateur">
        <flowNodeRef>taskValidationAdmin</flowNodeRef>
        <flowNodeRef>boundaryTimerAdmin</flowNodeRef>
        <flowNodeRef>gwDecisionAdmin</flowNodeRef>
        <flowNodeRef>gwMaxInfosAtteint</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="startEvent" name="Modification donnee sensible demandee" />
    <endEvent id="endClientTimeout" name="Timeout client 24h" />
    <endEvent id="endRejectedAdmin" name="Rejete par admin" />
    <endEvent id="endEscalade" name="Escalade superviseur" />
    <endEvent id="endApproved" name="Demande approuvee" />
    <boundaryEvent id="boundaryTimerClient" attachedToRef="taskFournirPreuve">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">PT24H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <boundaryEvent id="boundaryTimerAdmin" attachedToRef="taskValidationAdmin">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">PT48H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <userTask id="taskFournirPreuve" name="Fournir piece d identite / justificatif" flowable:assignee="${userId}" />
    <userTask id="taskValidationAdmin" name="Examiner la demande et le justificatif" flowable:candidateGroups="admin" />
    <serviceTask id="taskNotifyApprouve" name="Notifier la decision d approbation" flowable:delegateExpression="${notifyDelegate}" />
    <serviceTask id="taskAuditLog" name="Enregistrer audit log" flowable:delegateExpression="${auditDelegate}" />
    <serviceTask id="taskNotifyRejet" name="Notifier rejete par admin" flowable:delegateExpression="${notifyDelegate}" />
    <serviceTask id="taskEscaladeTimeout" name="Escalader vers superviseur" flowable:delegateExpression="${escaladeDelegate}" />
    <exclusiveGateway id="gwDecisionAdmin" name="Decision Admin" />
    <exclusiveGateway id="gwMaxInfosAtteint" name="Nb demandes lt 3" />
    <sequenceFlow id="sf01" sourceRef="startEvent" targetRef="taskFournirPreuve" />
    <sequenceFlow id="sf05" sourceRef="taskValidationAdmin" targetRef="gwDecisionAdmin" />
    <sequenceFlow id="sfTimerAdmin" sourceRef="boundaryTimerAdmin" targetRef="taskEscaladeTimeout" />
    <sequenceFlow id="sfApprove" name="Approuver" sourceRef="gwDecisionAdmin" targetRef="taskNotifyApprouve">
      <conditionExpression xsi:type="tFormalExpression">${decision=='APPROVE'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfReject" name="Rejeter" sourceRef="gwDecisionAdmin" targetRef="taskNotifyRejet">
      <conditionExpression xsi:type="tFormalExpression">${decision=='REJECT'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfRequestInfo" name="Dem. infos" sourceRef="gwDecisionAdmin" targetRef="gwMaxInfosAtteint">
      <conditionExpression xsi:type="tFormalExpression">${decision=='REQUEST_INFO'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfInfoOk" name="Oui lt3" sourceRef="gwMaxInfosAtteint" targetRef="taskFournirPreuve">
      <conditionExpression xsi:type="tFormalExpression">${infoCount &lt; 3}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sfInfoMax" name="Non 3+" sourceRef="gwMaxInfosAtteint" targetRef="taskEscaladeTimeout">
      <conditionExpression xsi:type="tFormalExpression">${infoCount&gt;=3}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf06" sourceRef="taskFournirPreuve" targetRef="taskValidationAdmin" />
    <sequenceFlow id="sfClientTimeout" sourceRef="boundaryTimerClient" targetRef="endClientTimeout" />
    <sequenceFlow id="sfRejetEnd" sourceRef="taskNotifyRejet" targetRef="endRejectedAdmin" />
    <sequenceFlow id="sfEscalade" sourceRef="taskEscaladeTimeout" targetRef="endEscalade" />
    <sequenceFlow id="sfApprouveAudit" sourceRef="taskNotifyApprouve" targetRef="taskAuditLog" />
    <sequenceFlow id="sfApprouveEnd" sourceRef="taskAuditLog" targetRef="endApproved" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="dataUpdateValidationProcess">
      <bpmndi:BPMNShape id="laneAdmin_sh" bpmnElement="laneAdmin" isHorizontal="true">
        <dc:Bounds x="130" y="520" width="2480" height="300" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="laneSysteme_sh" bpmnElement="laneSysteme" isHorizontal="true">
        <dc:Bounds x="130" y="210" width="2480" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="laneClient_sh" bpmnElement="laneClient" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="2480" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startEvent_sh" bpmnElement="startEvent">
        <dc:Bounds x="242" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="218" y="170" width="84" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejectedAdmin_sh" bpmnElement="endRejectedAdmin">
        <dc:Bounds x="2322" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2298" y="315" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEscalade_sh" bpmnElement="endEscalade">
        <dc:Bounds x="2522" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2498" y="435" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endApproved_sh" bpmnElement="endApproved">
        <dc:Bounds x="2002" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1978" y="315" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taskNotifyApprouve_sh" bpmnElement="taskNotifyApprouve">
        <dc:Bounds x="1580" y="260" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taskAuditLog_sh" bpmnElement="taskAuditLog">
        <dc:Bounds x="1790" y="260" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taskNotifyRejet_sh" bpmnElement="taskNotifyRejet">
        <dc:Bounds x="2100" y="260" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taskEscaladeTimeout_sh" bpmnElement="taskEscaladeTimeout">
        <dc:Bounds x="2300" y="380" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endClientTimeout_sh" bpmnElement="endClientTimeout">
        <dc:Bounds x="1332" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1305" y="170" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taskFournirPreuve_sh" bpmnElement="taskFournirPreuve">
        <dc:Bounds x="510" y="110" width="180" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taskValidationAdmin_sh" bpmnElement="taskValidationAdmin">
        <dc:Bounds x="700" y="640" width="180" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwDecisionAdmin_sh" bpmnElement="gwDecisionAdmin" isMarkerVisible="true">
        <dc:Bounds x="1175" y="595" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1110.5" y="593" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwMaxInfosAtteint_sh" bpmnElement="gwMaxInfosAtteint" isMarkerVisible="true">
        <dc:Bounds x="1415" y="595" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1465.5" y="593" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundaryTimerClient_sh" bpmnElement="boundaryTimerClient">
        <dc:Bounds x="662" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundaryTimerAdmin_sh" bpmnElement="boundaryTimerAdmin">
        <dc:Bounds x="852" y="682" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1268" y="675" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf01_e" bpmnElement="sf01">
        <di:waypoint x="278" y="145" />
        <di:waypoint x="510" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf05_e" bpmnElement="sf05">
        <di:waypoint x="877" y="643" />
        <di:waypoint x="1175" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfTimerAdmin_e" bpmnElement="sfTimerAdmin">
        <di:waypoint x="888" y="700" />
        <di:waypoint x="888" y="790" />
        <di:waypoint x="2400" y="790" />
        <di:waypoint x="2400" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfApprove_e" bpmnElement="sfApprove">
        <di:waypoint x="1200" y="595" />
        <di:waypoint x="1200" y="240" />
        <di:waypoint x="1660" y="240" />
        <di:waypoint x="1660" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1391" y="222" width="51" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfReject_e" bpmnElement="sfReject">
        <di:waypoint x="1200" y="645" />
        <di:waypoint x="1200" y="740" />
        <di:waypoint x="2080" y="740" />
        <di:waypoint x="2080" y="340" />
        <di:waypoint x="2180" y="340" />
        <di:waypoint x="2180" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1627" y="720" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfRequestInfo_e" bpmnElement="sfRequestInfo">
        <di:waypoint x="1225" y="620" />
        <di:waypoint x="1415" y="620" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1296" y="602" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfInfoOk_e" bpmnElement="sfInfoOk">
        <di:waypoint x="1440" y="595" />
        <di:waypoint x="1440" y="340" />
        <di:waypoint x="600" y="340" />
        <di:waypoint x="600" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1454" y="423" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfInfoMax_e" bpmnElement="sfInfoMax">
        <di:waypoint x="1440" y="645" />
        <di:waypoint x="1440" y="700" />
        <di:waypoint x="2080" y="700" />
        <di:waypoint x="2080" y="410" />
        <di:waypoint x="2300" y="410" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1751" y="680" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf06_e" bpmnElement="sf06">
        <di:waypoint x="560" y="170" />
        <di:waypoint x="560" y="570" />
        <di:waypoint x="790" y="570" />
        <di:waypoint x="790" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sfClientTimeout_e" bpmnElement="sfClientTimeout">
        <di:waypoint x="698" y="170" />
