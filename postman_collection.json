    {
      "name": "🔐 AUTHENTICATION & SECURITY",
      "item": [
        {
          "name": "1. Register New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response contains accessToken', function () {",
                  "    pm.expect(pm.response.json().accessToken).to.exist;",
                  "});",
                  "",
                  "pm.test('Response contains refreshToken', function () {",
                  "    pm.expect(pm.response.json().refreshToken).to.exist;",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('accessToken', jsonData.accessToken);",
                  "pm.environment.set('refreshToken', jsonData.refreshToken);",
                  "pm.environment.set('userId', 'test-user');",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
              "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
